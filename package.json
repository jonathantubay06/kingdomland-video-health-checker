{
  "name": "kingdomland-video-checker",
  "version": "1.0.0",
  "description": "Automatically logs into go.kingdomlandkids.com and verifies every video on the home page loads correctly. Generates pass/fail reports + a dashboard for monitoring uptime and performance.",
  "main": "check-videos.js",
  "scripts": {
    "start": "node server.js",
    "check": "node check-videos.js",
    "check:debug": "node check-videos.js --debug",
    "check:firefox": "node check-videos.js --browser=firefox",
    "check:webkit": "node check-videos.js --browser=webkit",
    "test": "vitest run",
    "test:watch": "vitest",
    "daily-summary": "node daily-summary.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "dotenv": "^17.3.1",
    "express": "^4.21.0",
    "node-cron": "^4.2.1",
    "playwright": "^1.59.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "vitest": "^4.0.18"
  }
}
